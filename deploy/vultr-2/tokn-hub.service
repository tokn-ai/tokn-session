[Unit]
Description=Tokn Session Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tokn-hub
Group=tokn-hub
WorkingDirectory=/opt/tokn-hub/current
ExecStart=/opt/tokn-hub/current/tokn-session-hub serve --bind 127.0.0.1:5559 --public-url https://ahub.clouds56.top --state-path /var/lib/tokn-hub/state.sqlite --web-root /opt/tokn-hub/current/web
StateDirectory=tokn-hub
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
